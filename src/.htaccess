<Files "config.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<Files "lib.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<FilesMatch "\.(sqlite|sqlite3|db)(-wal|-shm|-journal)?$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes

# REST API plugin (liteadmin-restapi): route /api/<db>/<table> to its front
# controller. Harmless when the plugin is not installed (the target 404s).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/(.+)$ plugins/liteadmin-restapi/api.php?_path=$1 [QSA,L]
</IfModule>

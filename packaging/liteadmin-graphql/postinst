#!/bin/sh
set -e

# Unlike most LiteAdmin plugins, the GraphQL API is NOT enabled automatically: it
# serves database contents, so enabling it is left an explicit, deliberate step.
# Choose which databases/tables to expose in the REST API panel, then enable it
# by adding "liteadmin-graphql" to "plugins" in /etc/liteadmin/config.json.
if [ "$1" = "configure" ]; then
    echo "liteadmin-graphql installed but not enabled."
    echo "Enable it by adding \"liteadmin-graphql\" to \"plugins\" in /etc/liteadmin/config.json"
    echo "(it depends on liteadmin-apikeys and liteadmin-restapi, which must also be enabled)."
fi

exit 0

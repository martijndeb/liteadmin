:80 {
	root * /var/www/liteadmin/src
	encode zstd gzip

	# These rules are a set: `path` does not resolve "..", so /ext/../config.json
	# is caught by the /config.json rule rather than by /ext/*. Every sensitive
	# path needs its own rule.
	@blocked {
		path /config.json
		path /lib.php
		path /databases/*
		path /data/*
		path /ext/*
		path *.sqlite *.sqlite3 *.db *.sqlite-wal *.sqlite-shm *.sqlite-journal
	}
	respond @blocked 403

	# REST API plugin (liteadmin-restapi): /api/<db>/<table> -> its front controller.
	# Harmless 404 when the plugin is not installed.
	@restapi path_regexp restapi ^/api/(.+)$
	rewrite @restapi /plugins/liteadmin-restapi/api.php?_path={re.restapi.1}&{query}

	php_fastcgi 127.0.0.1:9000
	file_server {
		index index.php
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}
}
